#!/bin/sh
# Bloque le commit si Ruff ou la suite de tests échoue.
# Activation (une fois par clone) : git config core.hooksPath .githooks
set -e
PY=.venv/Scripts/python.exe
[ -x "$PY" ] || PY=.venv/bin/python
# Notebooks exclus : épinglés par les preuves V1 (voir docs/PLAN_V2.md, phase 0).
"$PY" -m ruff check src tests scripts app
"$PY" -m pytest -q -p no:cacheprovider
